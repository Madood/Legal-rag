# Python Service Configuration
PYTHONUTF8=1
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Embedding Service
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_CACHE_DIR=./data/cache/embeddings
EMBEDDING_DIMENSION=768

# Vector Store
VECTOR_STORE_TYPE=faiss  # faiss, chroma, or qdrant
INDICES_DIR=./data/indices

# ChromaDB Settings
CHROMA_PERSIST_DIR=./data/chroma

# Qdrant Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333

# PDF Processing
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
MAX_PDF_PAGES=1000

# Processing Limits
MAX_CONCURRENT_PROCESSES=4
EMBEDDING_BATCH_SIZE=32

# Cache Settings
CACHE_TTL=86400  # 24 hours in seconds

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/python_service.log

# AI Doctrine Fallback (DeepSeek primary → Gemini Flash secondary)
# Used when a legal doctrine isn't in the hardcoded DOCTRINES dict
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=